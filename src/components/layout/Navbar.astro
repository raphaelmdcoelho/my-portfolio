---
import { config } from '../../data/config';
import { getLang, localePath, stripLocale, useTranslations } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const navLinks = [
  { id: 'about', label: t.nav.about },
  { id: 'skills', label: t.nav.skills },
  { id: 'projects', label: t.nav.projects },
  { id: 'blog', label: t.nav.blog },
  { id: 'contact', label: t.nav.contact },
].map(({ id, label }) => ({ id, label, href: `${localePath(lang)}#${id}` }));

// Same page in the other language
const otherLang = lang === 'en' ? 'pt' : 'en';
const onBlog = stripLocale(Astro.url.pathname).startsWith('blog');
const switchHref = localePath(otherLang, stripLocale(Astro.url.pathname));
---

<header
  id="navbar"
  class="navbar fixed top-0 left-0 right-0 z-50"
>
  <div class="navbar-inner content-wrap flex items-center justify-between">
    <!-- Logo -->
    <a
      href={`${localePath(lang)}#hero`}
      class="navbar-logo font-mono font-bold text-lg"
      aria-label={t.nav.home}
    >
      &lt;{config.name.split(' ')[0].toLowerCase()} /&gt;
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8" aria-label={t.nav.main}>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link font-mono text-sm transition-colors duration-200', { active: onBlog && link.id === 'blog' }]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={switchHref}
        hreflang={otherLang}
        lang={otherLang}
        class="lang-switch font-mono text-xs px-2 py-1 rounded border transition-colors duration-200"
        aria-label={t.langSwitchLabel}
      >
        {t.langSwitchShort}
      </a>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="menu-toggle"
      class="navbar-toggle md:hidden p-2 rounded"
      aria-label={t.nav.toggleMenu}
      aria-expanded="false"
    >
      <svg id="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
      <svg id="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="mobile-menu hidden md:hidden px-6 pb-4">
    <nav class="flex flex-col gap-4 pt-4" aria-label={t.nav.mobile}>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link font-mono text-sm py-1 transition-colors duration-200"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={switchHref}
        hreflang={otherLang}
        lang={otherLang}
        class="lang-switch font-mono text-xs px-2 py-1 rounded border w-fit transition-colors duration-200"
        aria-label={t.langSwitchLabel}
      >
        {t.langSwitchShort}
      </a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    background: transparent;
    /* Reserve the border up front, so it never animates from currentColor (white flash). */
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s, border-color 0.3s;
  }

  .navbar-inner {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .navbar-logo {
    color: var(--color-accent);
  }

  .navbar-toggle {
    color: var(--color-text);
  }

  .nav-link,
  .mobile-nav-link {
    color: var(--color-muted);
  }

  .nav-link:hover,
  .mobile-nav-link:hover {
    color: var(--color-accent) !important;
  }

  .lang-switch {
    color: var(--color-accent);
    border-color: var(--color-border);
  }

  .lang-switch:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-dim);
  }

  .nav-link.active {
    color: var(--color-accent) !important;
  }

  .mobile-menu {
    background: var(--color-surface);
  }

  #navbar.scrolled {
    background: rgba(10, 10, 10, 0.9) !important;
    backdrop-filter: blur(12px);
    border-bottom-color: var(--color-border);
  }
</style>

<script>
  const navbar = document.getElementById('navbar');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  // Scroll: add bg on scroll
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      navbar?.classList.add('scrolled');
    } else {
      navbar?.classList.remove('scrolled');
    }
  });

  // Mobile menu toggle
  menuToggle?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    menuToggle.setAttribute('aria-expanded', String(!isOpen));
  });

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });

  // Keep the current section when switching language
  document.querySelectorAll<HTMLAnchorElement>('.lang-switch').forEach((link) => {
    link.addEventListener('click', () => {
      link.hash = window.location.hash;
    });
  });

  // Active section highlighting
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((link) => {
            link.classList.remove('active');
            if (link.getAttribute('href')?.endsWith(`#${entry.target.id}`)) {
              link.classList.add('active');
            }
          });
        }
      });
    },
    { rootMargin: '-40% 0px -55% 0px' }
  );

  sections.forEach((section) => observer.observe(section));
</script>
