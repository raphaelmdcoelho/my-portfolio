---
import { projects } from '../../data/projects';
import { getLang, loc, localePath, useTranslations } from '../../i18n/utils';
import ProjectCarousel from '../ui/ProjectCarousel';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const resolved = projects.map((p) => ({ ...p, description: loc(p.description, lang) }));
---

<section id="projects" style="padding-top: 6rem; padding-bottom: 6rem;" aria-label={t.projects.aria}>
  <div class="content-wrap">
    <h2 class="section-title reveal reveal-left"><span>#</span> {t.projects.title}</h2>
    <div class="section-divider reveal"></div>

    <div class="reveal">
      <ProjectCarousel client:visible projects={resolved} labels={t.projects} />
    </div>

    <div class="reveal" style="margin-top: 2rem; text-align: center;">
      <a href={localePath(lang, 'projects/')} class="font-mono text-sm view-all">{t.projects.viewAll} →</a>
    </div>
  </div>
</section>

<style>
  .view-all { color: var(--color-accent); text-decoration: none; }
  .view-all:hover { text-decoration: underline; }
</style>
