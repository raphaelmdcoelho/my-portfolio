---
import { blogPosts } from '../../data/blog';
import BlogCarousel from '../ui/BlogCarousel';
import { formatDate, getLang, loc, localePath, useTranslations } from '../../i18n/utils';

const MAX_POSTS = 5;

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const posts = [...blogPosts]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, MAX_POSTS)
  .map((post) => ({
    id: post.id,
    title: loc(post.title, lang),
    excerpt: loc(post.excerpt, lang),
    date: post.date,
    formattedDate: formatDate(post.date, lang),
    href: localePath(lang, `blog/${post.id}/`),
    tags: post.tags,
  }));
---

<section
  id="blog"
  style="background: var(--color-surface); padding-top: 6rem; padding-bottom: 6rem;"
  aria-label={t.blog.aria}
>
  <div class="content-wrap">
    <h2 class="section-title reveal reveal-left"><span>#</span> {t.blog.title}</h2>
    <div class="section-divider reveal"></div>

    <div class="reveal">
      <BlogCarousel client:visible posts={posts} labels={t.blog} />
    </div>

    <div class="reveal view-all">
      <a href={localePath(lang, 'blog/')} class="view-all-link font-mono text-sm">
        {t.blog.viewAll} <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .view-all { display: flex; justify-content: center; margin-top: 2rem; }
  .view-all-link {
    color: var(--color-accent); text-decoration: none;
    padding: 0.6rem 1.25rem; border: 1px solid var(--color-border); border-radius: 9999px;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .view-all-link:hover { border-color: var(--color-accent); background: var(--color-accent-dim); transform: translateY(-2px); }
</style>
