---
import { config } from '../../data/config';
import { getLang, loc, useTranslations } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const base = '/my-portfolio/images/about';
const album = [
  { src: `${base}/portrait.png`, tilt: -3, shift: 0.5, alt: t.about.album.code },
  { src: `${base}/family.png`, tilt: 2.5, shift: -0.5, alt: t.about.album.family },
  { src: `${base}/cooking.png`, tilt: -2, shift: 0.75, alt: t.about.album.cooking },
  { src: `${base}/gym.png`, tilt: 3, shift: -0.25, alt: t.about.album.gym },
  { src: `${base}/reading.png`, tilt: -3.5, shift: 0.5, alt: t.about.album.reading },
  { src: `${base}/sushi.png`, tilt: 2.5, shift: -0.5, alt: t.about.album.sushi },
];
---

<section id="about" class="section" aria-label={t.about.aria}>
  <div class="content-wrap">
    <h2 class="section-title reveal reveal-left"><span>#</span> {t.about.title}</h2>
    <div class="section-divider reveal"></div>
  </div>

  <div class="about-wide">
    <div class="about-grid">

      <!-- Text -->
      <div class="reveal about-text-col">
        <div class="space-y-4">
          {
            loc(config.bio, lang).split('\n').filter(Boolean).map((paragraph) => (
              <p class="about-bio leading-relaxed">
                {paragraph.trim()}
              </p>
            ))
          }
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={config.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="about-link font-mono text-sm px-4 py-2 rounded border transition-all duration-200"
          >
            GitHub
          </a>
          <a
            href={config.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="about-link font-mono text-sm px-4 py-2 rounded border transition-all duration-200"
          >
            LinkedIn
          </a>
          <a
            href={config.social.medium}
            target="_blank"
            rel="noopener noreferrer"
            class="about-link font-mono text-sm px-4 py-2 rounded border transition-all duration-200"
          >
            Medium
          </a>
        </div>
      </div>

      <ul class="album reveal" aria-label={t.about.albumLabel}>
        {album.map((photo, i) => (
          <li class="photo" style={`--tilt: ${photo.tilt}deg; --shift: ${photo.shift}rem; --z: ${i + 1};`} tabindex="0">
            <img src={photo.src} alt={photo.alt} width="640" height="640" loading="lazy" draggable="false" />
          </li>
        ))}
      </ul>

      <!-- Placeholder: no action wired up yet. -->
      <div class="flex justify-center reveal">
        <button type="button" class="about-link cv-button font-mono text-sm px-6 py-3 rounded border transition-all duration-200">
          {t.about.downloadCv}
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .cv-button { cursor: pointer; background: transparent; }

  .about-bio {
    color: var(--color-muted);
  }

  .about-link {
    color: var(--color-accent);
    border-color: var(--color-border);
  }

  .about-link:hover {
    background: var(--color-accent-dim);
    border-color: var(--color-accent) !important;
  }

  .about-wide { width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  @media (min-width: 768px) { .about-wide { padding: 0 3rem; } }

  .about-grid { display: grid; gap: 3rem; }
  /* Align with the title column above, which is narrower than the photo row. */
  .about-text-col { width: 100%; max-width: 764px; margin: 0 auto; }

  /* Overlapping fan of photos: all stay visible, the hovered/selected one lifts to the front. */
  .album {
    --w: clamp(5rem, 28vw, 17rem);
    list-style: none; margin: 0 auto; padding: 2rem 0.5rem;
    box-sizing: content-box; max-width: calc(var(--w) * 2.8); /* caps a row at three photos */
    display: flex; flex-wrap: wrap; justify-content: center; align-items: center; row-gap: 1.5rem;
  }
  .photo {
    width: var(--w); flex-shrink: 0; padding: 0.4rem; border-radius: 0.75rem; cursor: pointer; outline: none;
    background: linear-gradient(145deg, var(--color-accent), rgba(124, 92, 255, 0.75));
    box-shadow: 0 0 20px var(--color-accent-dim), 0 12px 28px rgba(0, 0, 0, 0.55);
    transform: translateY(var(--shift)) rotate(var(--tilt));
    z-index: var(--z); position: relative;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .photo + .photo { margin-left: calc(var(--w) * -0.28); }
  /* Two rows of three: the first photo of each row starts the row, so it doesn't overlap backwards. */
  .photo:nth-child(4) { margin-left: 0; }
  /* Phones: three rows of two. */
  @media (max-width: 639px) {
    .album { --w: 40vw; max-width: calc(var(--w) * 2); }
    .photo:nth-child(4) { margin-left: calc(var(--w) * -0.28); }
    .photo:nth-child(3), .photo:nth-child(5) { margin-left: 0; }
    /* Mirrored tilt and no vertical offsets, so each row is symmetric. */
    .photo { --shift: 0rem !important; }
    .photo:nth-child(odd) { --tilt: -2.5deg !important; }
    .photo:nth-child(even) { --tilt: 2.5deg !important; }
  }
  .photo:hover, .photo:focus-visible, .photo.active {
    z-index: 10;
    transform: translateY(-0.75rem) rotate(0deg) scale(1.15);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  }
  .photo img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 0.5rem; pointer-events: none; }
  @media (prefers-reduced-motion: reduce) {
    .photo { transition: none; }
  }
</style>

<script>
  // Tap/click selects a photo (hover doesn't exist on touch); tapping elsewhere clears it.
  const photos = document.querySelectorAll<HTMLElement>('.album .photo');
  photos.forEach((photo) => {
    photo.addEventListener('click', (e) => {
      e.stopPropagation();
      const wasActive = photo.classList.contains('active');
      photos.forEach((p) => p.classList.remove('active'));
      if (!wasActive) photo.classList.add('active');
    });
  });
  document.addEventListener('click', () => photos.forEach((p) => p.classList.remove('active')));
</script>
