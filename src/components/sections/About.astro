---
import { config } from '../../data/config';
import { getLang, loc, useTranslations } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const base = '/my-portfolio/images/about';
const album = [
  { src: `${base}/portrait.png`, tilt: -3, ...t.about.album.code },
  { src: `${base}/family.png`, tilt: 2.5, ...t.about.album.family },
  { src: `${base}/gym.png`, tilt: 3, ...t.about.album.gym },
  { src: `${base}/sushi.png`, tilt: -2.5, ...t.about.album.sushi },
];
---

<section id="about" class="section" aria-label={t.about.aria}>
  <div class="content-wrap">
    <h2 class="section-title reveal reveal-left"><span>#</span> {t.about.title}</h2>
    <div class="section-divider reveal"></div>

    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Text -->
      <div class="reveal">
        <div class="space-y-4">
          {
            loc(config.bio, lang).split('\n').filter(Boolean).map((paragraph) => (
              <p class="about-bio leading-relaxed">
                {paragraph.trim()}
              </p>
            ))
          }
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={config.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="about-link font-mono text-sm px-4 py-2 rounded border transition-all duration-200"
          >
            GitHub
          </a>
          <a
            href={config.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="about-link font-mono text-sm px-4 py-2 rounded border transition-all duration-200"
          >
            LinkedIn
          </a>
          <a
            href={config.social.medium}
            target="_blank"
            rel="noopener noreferrer"
            class="about-link font-mono text-sm px-4 py-2 rounded border transition-all duration-200"
          >
            Medium
          </a>
        </div>
      </div>

      <!-- Photo album -->
      <ul class="album reveal" aria-label={t.about.albumLabel}>
        {
          album.map((photo) => (
            <li class="photo" style={`--tilt: ${photo.tilt}deg;`}>
              <figure>
                <img src={photo.src} alt={photo.alt} width="640" height="640" loading="lazy" draggable="false" />
                <figcaption class="font-mono">{photo.caption}</figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about-bio {
    color: var(--color-muted);
  }

  .about-link {
    color: var(--color-accent);
    border-color: var(--color-border);
  }

  .about-link:hover {
    background: var(--color-accent-dim);
    border-color: var(--color-accent) !important;
  }

  /* Tilted polaroid-style album, framed with the site's accent glow. */
  .album {
    list-style: none; padding: 0.5rem; margin: 0; width: min(100%, 30rem); justify-self: end;
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem;
  }
  .photo { transform: rotate(var(--tilt)); transition: transform 0.25s, z-index 0s; }
  .photo:nth-child(even) { margin-top: 1.5rem; }
  .photo:hover { transform: rotate(0deg) scale(1.06); z-index: 1; }
  .photo figure {
    margin: 0; padding: 0.5rem 0.5rem 0.4rem; border-radius: 0.75rem;
    background: linear-gradient(145deg, var(--color-accent), rgba(124, 92, 255, 0.75));
    box-shadow: 0 0 30px var(--color-accent-dim), 0 14px 30px rgba(0, 0, 0, 0.5);
  }
  .photo img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 0.5rem; }
  .photo figcaption { margin-top: 0.4rem; text-align: center; font-size: 0.72rem; font-weight: 700; color: var(--color-bg); }

  @media (max-width: 767px) {
    .album { justify-self: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo, .photo:hover { transition: none; }
  }
</style>
