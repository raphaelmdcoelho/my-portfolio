---
import { config } from '../../data/config';
import { getLang, loc, useTranslations } from '../../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section id="about" class="section" aria-label={t.about.aria}>
  <div class="content-wrap">
    <h2 class="section-title reveal reveal-left"><span>#</span> {t.about.title}</h2>
    <div class="section-divider reveal"></div>

    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Text -->
      <div class="reveal">
        <div class="space-y-4">
          {
            loc(config.bio, lang).split('\n').filter(Boolean).map((paragraph) => (
              <p class="about-bio leading-relaxed">
                {paragraph.trim()}
              </p>
            ))
          }
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={config.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="about-link font-mono text-sm px-4 py-2 rounded border transition-all duration-200"
          >
            GitHub
          </a>
          <a
            href={config.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="about-link font-mono text-sm px-4 py-2 rounded border transition-all duration-200"
          >
            LinkedIn
          </a>
          <a
            href={config.social.medium}
            target="_blank"
            rel="noopener noreferrer"
            class="about-link font-mono text-sm px-4 py-2 rounded border transition-all duration-200"
          >
            Medium
          </a>
        </div>
      </div>

      <!-- Avatar -->
      <div class="flex justify-center md:justify-end reveal">
        <div class="avatar-frame relative overflow-hidden">
          <img
            src={config.avatar}
            alt={t.about.portraitOf(config.name)}
            class="w-full h-full object-cover"
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <!-- Fallback placeholder -->
          <div
            class="avatar-fallback absolute inset-0 items-center justify-center flex-col gap-2"
            style="display: none;"
            aria-hidden="true"
          >
            <svg class="avatar-fallback-icon" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
              <circle cx="12" cy="8" r="4" />
              <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" />
            </svg>
            <span class="avatar-fallback-label font-mono text-xs">avatar.jpg</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-bio {
    color: var(--color-muted);
  }

  .about-link {
    color: var(--color-accent);
    border-color: var(--color-border);
  }

  .about-link:hover {
    background: var(--color-accent-dim);
    border-color: var(--color-accent) !important;
  }

  /* Same accent-glow gradient frame as the blog header avatar. */
  .avatar-frame {
    width: min(100%, 22rem);
    aspect-ratio: 1;
    border-radius: 1.5rem;
    padding: 3px;
    background: linear-gradient(145deg, var(--color-accent), rgba(124, 92, 255, 0.75));
    box-shadow: 0 0 40px var(--color-accent-dim), 0 18px 40px rgba(0, 0, 0, 0.5);
  }

  .avatar-frame img {
    border-radius: calc(1.5rem - 3px);
  }

  .avatar-fallback {
    background: var(--color-surface-2);
  }

  .avatar-fallback-icon {
    color: var(--color-muted);
  }

  .avatar-fallback-label {
    color: var(--color-muted);
  }
</style>
