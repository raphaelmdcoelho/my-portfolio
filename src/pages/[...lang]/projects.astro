---
import Layout from '../../components/layout/Layout.astro';
import { projects } from '../../data/projects';
import { getLang, loc, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'pt' } }];
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const items = projects.map((p) => ({ ...p, description: loc(p.description, lang) }));
---

<Layout title={t.projects.pageTitle} description={t.projects.pageIntro}>
  <div class="projects-page content-wrap">
    <header>
      <h1 class="section-title"><span>#</span> {t.projects.title}</h1>
      <div class="section-divider"></div>
      <p class="intro">{t.projects.pageIntro}</p>
      <p class="count font-mono">{t.projects.count(items.length)}</p>
    </header>

    <ul class="grid">
      {
        items.map((p) => (
          <li>
            <article class="card">
              <div class="thumb">
                <img src={p.imageUrl} alt={t.projects.screenshotOf.replace('{title}', p.title)} loading="lazy" />
                {p.featured && <span class="badge font-mono">{t.projects.featured}</span>}
              </div>
              <div class="body">
                <h2 class="title font-mono">{p.title}</h2>
                <p class="desc">{p.description}</p>
                <div class="tags">
                  {p.tags.map((tag) => <span class="tag font-mono">{tag}</span>)}
                </div>
                <div class="links">
                  {p.repoUrl && (
                    <a class="link font-mono" href={p.repoUrl} target="_blank" rel="noopener noreferrer" aria-label={t.projects.repoAria.replace('{title}', p.title)}>
                      {t.projects.source}
                    </a>
                  )}
                  {p.liveUrl && (
                    <a class="link font-mono" href={p.liveUrl} target="_blank" rel="noopener noreferrer" aria-label={t.projects.liveAria.replace('{title}', p.title)}>
                      {t.projects.liveDemo} <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>

<style>
  .projects-page { padding-top: 8rem; padding-bottom: 6rem; }
  .intro { color: var(--color-muted); max-width: 40rem; line-height: 1.7; margin-top: 1.25rem; }
  .count { color: var(--color-muted); font-size: 0.75rem; margin: 1.5rem 0; }

  .grid {
    list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem;
    grid-template-columns: repeat(2, 1fr); grid-auto-rows: 1fr;
  }
  .card {
    height: 100%; display: flex; flex-direction: column; overflow: hidden; border-radius: 1rem;
    background: linear-gradient(160deg, var(--color-surface-2), var(--color-surface));
    border: 1px solid var(--color-border);
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }
  .card:hover {
    border-color: var(--color-accent); transform: translateY(-4px);
    box-shadow: 0 0 30px var(--color-accent-dim), 0 20px 40px rgba(0, 0, 0, 0.4);
  }
  .thumb { position: relative; height: 16rem; margin: 1rem 1rem 0; border-radius: 0.5rem; overflow: hidden; background: var(--color-surface-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .badge {
    position: absolute; top: 0.75rem; right: 0.75rem; font-size: 0.7rem; font-weight: 700;
    color: var(--color-bg); background: var(--color-accent); padding: 0.2rem 0.5rem; border-radius: 0.25rem;
  }
  .body { display: flex; flex-direction: column; flex: 1; gap: 0.75rem; padding: 1.25rem; }
  .title { color: var(--color-text); font-size: 1.1rem; font-weight: 700; }
  .desc { color: var(--color-muted); font-size: 0.9rem; line-height: 1.7; flex: 1; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .tag {
    background: var(--color-surface-2); color: var(--color-accent); border: 1px solid var(--color-border);
    font-size: 0.72rem; padding: 0.125rem 0.5rem; border-radius: 0.25rem;
  }
  .links { display: flex; gap: 1rem; margin-top: auto; }
  .link { color: var(--color-muted); font-size: 0.8rem; text-decoration: none; transition: color 0.2s; }
  .link:hover { color: var(--color-accent); }

  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; }
    .projects-page { padding-top: 6.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card, .card:hover { transform: none; transition: none; }
  }
</style>
